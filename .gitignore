# Byte-compiled / build artifacts
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
.env

# A save killed part-way leaves its temporary beside the target (io/hdf5.py, export.py)
*.partial
.partial-*

# What the example notebooks write when executed where they sit (run them from a copy)
notebooks/hcp-ya/
notebooks/exports/

# Test / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/

# Generated figures, reports and logs
*.png
*.pdf
*.log

# Docs
_build/
.jupyter_cache/

# Editor / OS cruft -- these were committed in the old repos (WP4 hygiene)
.vs/
.asv/
.DS_Store
.idea/
*.swp

# SLURM
slurm-*.out

# Data: never commit derivatives or tractograms
*.h5
*.mat
*.tck
*.trk
*.nii
*.nii.gz

# gprof output, dropped wherever concon's profiled c3_main binary is run
gmon.out
# the example figures are committed; everything else drawn while working is not
!docs/figures/*.png
